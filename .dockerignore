**/.turbo
**/dist
**/build
**/coverage
**/test-results
**/playwright-report
**/*.log*
.agent
.agents
.claude
.gemini
.specify
manual-planning
specs
docs
apps/desktop
apps/fumadocs
.codegraph
.codex
.plan
.config
.vscode
.mcp.json
