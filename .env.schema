# Shared root Varlock schema (ADR-0005). Service-owned schemas
# (apps/server/.env.schema, apps/web/.env.schema, packages/db/.env.schema)
# `@import(../../)` this file for the definitions below.
#
# CHURCH_EXEC_PURPOSE is the single explicit execution purpose a command
# selects. It is never derived from NODE_ENV, has no fallback, and gates
# which `.env.<purpose>` / `.env.<purpose>.local` overlay Varlock loads.
# @defaultSensitive=false @defaultRequired=infer @currentEnv=$CHURCH_EXEC_PURPOSE
# ---

# @type=enum(development, unit, integration, e2e)
CHURCH_EXEC_PURPOSE=development

# E2E run coordination (set by apps/web/playwright.config.ts, inherited by
# every E2E process). Declared so Varlock forwards them to wrapped children;
# see tooling/env/e2e-environment.ts.
# @type=port
PW_SERVER_PORT=

# @type=port
PW_WEB_PORT=

# @type=url
PW_WEB_URL=

# @type=string
CHURCH_E2E_TARGET_FINGERPRINT=

# Worktree-local values generated into the root `.env.local` by
# `bun run env:local` (tooling/worktree/local-env.ts). Unset outside a
# generated worktree (CI), where database targets fall back to the
# "unspecified" worktree label.
# CHURCH_WORKTREE is the identity every worktree-scoped resource name derives
# from; see tooling/worktree/worktree-identity.ts.
# @type=string(maxLength=52, matches="^[a-z0-9]+(_[a-z0-9]+)*(__[0-9a-f]{8})?$")
CHURCH_WORKTREE=

# @type=port
CHURCH_SERVER_PORT=

# @type=port
CHURCH_WEB_PORT=

# Machine-shared (`church-shared.env`, copied into `.env.local`): this
# machine's development domain, which env:local builds the manual URL set
# on. Declared so Varlock forwards it to apps/web/vite.config.ts, which
# accepts it as a dev-server Host. Unset means `localhost`.
# @type=string
CHURCH_DEV_DOMAIN=
