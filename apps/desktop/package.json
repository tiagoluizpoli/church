{
  "name": "@church/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo -F @church/web build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "turbo -F @church/web dev",
    "build": "turbo -F @church/web build && electrobun build",
    "build:stable": "turbo -F @church/web build && electrobun build --env=stable",
    "build:canary": "turbo -F @church/web build && electrobun build --env=canary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electrobun": "^1.15.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "concurrently": "^9.1.0",
    "typescript": "^5"
  }
}
