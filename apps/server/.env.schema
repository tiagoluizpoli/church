# Server-owned Varlock schema (ADR-0005). Mirrors the fail-fast contract in
# packages/env/src/server.ts; Varlock is the loading/redaction/injection
# boundary, that Zod contract remains the application-facing typed API.
# @defaultSensitive=false @defaultRequired=infer
# @import(../../)
# ---

# The worktree's assigned port (`env:local`); a PORT already in the process
# environment (Playwright's E2E server) wins. Unset, the Zod contract
# defaults it.
# Optional: CI has no worktree port, and a referenced value alone would make
# it required.
# @optional @type=port
PORT=$CHURCH_SERVER_PORT

# @required @sensitive @type=string
DATABASE_URL=

# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @required @type=url
BETTER_AUTH_URL=

# @required @type=url
CORS_ORIGIN=

# @sensitive @type=string
RESEND_API_KEY=

# @type=string
RESEND_FROM_EMAIL=Church <onboarding@resend.dev>

# Development sender: smtp (default, Mailpit), resend or capture. Test is
# always capture and production always Resend. Restart the server to change it.
# @type=enum(smtp, resend, capture)
DEV_EMAIL_SENDER=

# Where this server runs, independent of NODE_ENV. local keeps the senders
# above. development and staging route each email by the database setting
# runtime_configuration.email_delivery_mode (mailpit, resend or both; SMTP_*
# is the Mailpit). production always uses Resend.
# @type=enum(local, development, staging, production)
CHURCH_ENVIRONMENT=

# @type=string
SMTP_HOST=localhost

# @type=number(min=1)
SMTP_PORT=1025

# @type=boolean
SMTP_SECURE=false

# Require STARTTLS (port 587 relays); SMTP_SECURE is implicit TLS (port 465).
# @type=boolean
SMTP_REQUIRE_TLS=false

# @type=string
SMTP_USER=

# @sensitive @type=string
SMTP_PASSWORD=

# @type=string
SMTP_FROM_EMAIL=Church <noreply@church.test>

# @type=number(min=1000)
OUTBOX_POLL_INTERVAL_MS=5000

# @type=number(min=1)
OUTBOX_DRAIN_BATCH_SIZE=10

# No default here: a value in this schema would shadow the root one; the Zod
# contract already defaults it to development.
# @type=enum(development, production, test)
NODE_ENV=

# Non-production only regardless of this flag; see packages/env/src/server.ts.
# No default here: a value in this schema would shadow the root one; the Zod
# contract already defaults it to false.
# @type=boolean
ENABLE_DEBUG_ENDPOINTS=

# Source revision the deployed image was built from (its build argument), so
# readiness can tell a stale container from the expected rollout. Local runs
# leave it unset; the Zod contract defaults it.
# @type=string
APP_REVISION=
