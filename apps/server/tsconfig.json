{
  "extends": "@church/config/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "verbatimModuleSyntax": false,
    "composite": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/tests/*": ["./tests/*"],
      "@/seeds/*": ["./seeds/*"],
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"
  }
}
