# Web-owned Varlock schema (ADR-0005). Mirrors packages/env/src/web.ts.
# @defaultSensitive=inferFromPrefix('VITE_') @defaultRequired=infer
# @import(../../)
# ---

# The API origin the browser calls: an absolute URL for local/worktree
# development and tests, or `/` in the deployed image, which reaches the API on
# its own origin through /api routing so one image serves any hostname.
# @required @type=string(matches="^(https?://[^/].*|/)$")
VITE_SERVER_URL=

# The worktree's assigned port (`env:local`); a PORT already in the process
# environment (Playwright's E2E web server) wins. Read by vite.config.ts.
# Optional: CI has no worktree port, and a referenced value alone would make
# it required.
# @optional @type=port
PORT=$CHURCH_WEB_PORT
