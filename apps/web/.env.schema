# Web-owned Varlock schema (ADR-0005). Mirrors packages/env/src/web.ts.
# @defaultSensitive=inferFromPrefix('VITE_') @defaultRequired=infer
# @import(../../)
# ---

# The API origin the browser calls: an absolute URL for local/worktree
# development and tests, or `/` in the deployed image, which reaches the API on
# its own origin through /api routing so one image serves any hostname.
# @required @type=string(matches="^(https?://[^/].*|/)$")
VITE_SERVER_URL=

# The source revision the image is built from (deployment/web.Dockerfile passes
# APP_REVISION). Error reports carry it; unset, the Zod contract defaults it.
# @optional @type=string
VITE_APP_REVISION=

# Google Maps keys, one pair per environment (owner task: billing account, keys,
# quotas, budget alert). The browser key is restricted by HTTP referrer to the
# environment's hostname and enables the address search and pin map; the Embed
# key is a separate key limited to the Maps Embed API (public page). Unset, the
# search and map are hidden and CEP plus manual entry still work.
# @optional @type=string
VITE_GOOGLE_MAPS_BROWSER_KEY=
# @optional @type=string
VITE_GOOGLE_MAPS_EMBED_KEY=
# The Map ID (Google Cloud > Map Management, JavaScript, vector) the pin map's
# Advanced Markers need; set it with the browser key. Development falls back to
# Google's DEMO_MAP_ID when unset.
# @optional @type=string
VITE_GOOGLE_MAPS_MAP_ID=

# The worktree's assigned port (`env:local`); a PORT already in the process
# environment (Playwright's E2E web server) wins. Read by vite.config.ts.
# Optional: CI has no worktree port, and a referenced value alone would make
# it required.
# @optional @type=port
PORT=$CHURCH_WEB_PORT
