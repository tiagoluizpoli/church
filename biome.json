{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": ["./tooling/biome/require-named-object-parameters.grit"],
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.next",
      "!!**/dist",
      "!!**/.turbo",
      "!!**/.nx",
      "!!**/dev-dist",
      "!!**/.zed",
      "!!**/.vscode",
      "!!**/routeTree.gen.ts",
      "!!**/src-tauri",
      "!!**/.nuxt",
      "!!**/bts.jsonc",
      "!!**/.expo",
      "!!**/.wrangler",
      "!!**/.alchemy",
      "!!**/.svelte-kit",
      "!!**/wrangler.jsonc",
      "!!**/.source",
      "!!**/convex/_generated",
      "!!**/.react-router",
      "!!**/.react-router-v7",
      "!!**/.react-router-v7-linux-x64-gnu",
      "!!**/build",
      "!**/*.md",
      "!!**/.agent",
      "!!**/.agents",
      "!!**/.specify",
      "!!**/.gemini",
      "!!**/.claude",
      "!!**/apps/fumadocs",
      "!!**/public",
      "!!**/node_modules",
      "!!**/.git",
      "!!**/.output",
      "!!**/.vercel",
      "!!**/playwright-report",
      "!!**/coverage",
      "!!**/test-results",
      "!!**/tmp",
      "!!**/packages/db/src/migrations",
      "!!**/apps/web/src/infrastructure/api",
      "!!**/skills-lock.json",
      "!!**/seed-data.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 80,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":URL:",
              ":NODE:",
              ":PACKAGE_WITH_PROTOCOL:",
              ":PACKAGE:",
              ":PATH:",
              ":ALIAS:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "info"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "variable" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "function" },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": { "kind": "class" },
                "formats": ["PascalCase"]
              },
              {
                "selector": { "kind": "typeAlias" },
                "formats": ["PascalCase"]
              },
              {
                "selector": { "kind": "enum" },
                "formats": ["PascalCase"]
              },
              {
                "selector": { "kind": "interface" },
                "formats": ["PascalCase"]
              },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "typeProperty" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              }
            ]
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["clsx", "cva", "cn"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/server/src/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/infrastructure/**", "!**/domain/**"],
                    "message": "api/ → domain/ only. Direct infrastructure layer import forbidden."
                  },
                  {
                    "group": ["**/application/**", "!**/domain/**"],
                    "message": "api/ → domain/ only. Direct application layer import forbidden; import interfaces from domain/contracts/application/ instead."
                  },
                  {
                    "group": ["**/domain/contracts/infrastructure/**"],
                    "message": "api/ → domain/contracts/application/ only for contracts. Infrastructure contracts (repositories/services) are for application and infrastructure layers only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/infrastructure/**", "!**/domain/**"],
                    "message": "domain/ → packages/* only. Infrastructure layer import forbidden from domain."
                  },
                  {
                    "group": ["**/application/**", "!**/domain/**"],
                    "message": "domain/ → packages/* only. Application layer import forbidden from domain."
                  },
                  {
                    "group": ["**/api/**"],
                    "message": "domain/ → packages/* only. API layer import forbidden from domain."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/infrastructure/**", "!**/domain/**"],
                    "message": "application/ → domain/ only. Infrastructure layer import forbidden; consume infra interfaces via domain/contracts/infrastructure/."
                  },
                  {
                    "group": ["**/api/**"],
                    "message": "application/ → domain/ only. API layer import forbidden from application."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/domain/contracts/contract-tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/application/**", "!**/domain/**"],
                    "message": "infrastructure/ → domain/ only. Application layer import forbidden from infrastructure."
                  },
                  {
                    "group": ["**/api/**"],
                    "message": "infrastructure/ → domain/ only. API layer import forbidden from infrastructure."
                  },
                  {
                    "group": ["**/domain/contracts/application/**"],
                    "message": "infrastructure/ → domain/contracts/infrastructure/ only for contracts. Manager interfaces (application contracts) are not for infrastructure layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/routes/**/*", "**/routeTree.gen.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/components/ui/**/*"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/routeTree.gen.ts", "**/app.config.timestamp_*.js"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": [
        "**/apps/fumadocs/.react-router/**/*",
        "**/apps/fumadocs/.react-router-v7/**/*",
        "**/apps/desktop/build/**/*",
        "**/.next/**/*",
        "**/dist/**/*",
        "**/+routes.ts"
      ],
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}
