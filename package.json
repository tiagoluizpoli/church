{
  "name": "church",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/server",
      "apps/web",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "better-auth": "1.5.5",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0",
      "vitest": "^3.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "dev:web": "turbo -F web dev",
    "dev:desktop": "turbo -F desktop dev:hmr",
    "build:desktop": "turbo -F desktop build:stable",
    "build:desktop:canary": "turbo -F desktop build:canary",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @church/db db:push",
    "db:studio": "turbo -F @church/db db:studio",
    "db:generate": "turbo -F @church/db db:generate",
    "db:migrate": "turbo -F @church/db db:migrate",
    "db:reset": "turbo -F @church/db db:reset",
    "db:start": "turbo -F @church/db db:start",
    "db:watch": "turbo -F @church/db db:watch",
    "db:stop": "turbo -F @church/db db:stop",
    "db:down": "turbo -F @church/db db:down",
    "db:init": "turbo -F @church/db db:init-system",
    "db:clean": "turbo -F @church/db db:clean",
    "db:seed": "turbo -F @church/db db:seed",
    "db:seed:reset": "turbo -F @church/db db:seed:reset",
    "db:seed:dev-users": "bun run --cwd apps/server seed:dev-users",
    "db:seed:reset:dev-users": "bun run db:seed:reset && bun run db:seed:dev-users",
    "lint": "bun run lint:files -- .",
    "lint:files": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "lint:fix": "bun run lint:fix:files -- .",
    "lint:fix:files": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "orval": "orval",
    "api:generate": "bun run --cwd apps/server export:openapi && orval",
    "test:unit": "turbo test:unit --concurrency=2 && bun run test:validation",
    "test:integration": "turbo test:integration --concurrency=1",
    "test:e2e": "turbo test:e2e --filter=web --",
    "test:e2e:ui": "turbo test:e2e:ui --filter=web --",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:validation": "bun test tooling/validation/affected.test.ts",
    "validate:affected": "bun tooling/validation/affected.ts",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "commit": "cz"
  },
  "dependencies": {
    "@church/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@church/config": "workspace:*",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.61.1",
    "@types/bun": "catalog:",
    "@types/three": "^0.184.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.4",
    "orval": "^8.19.0",
    "turbo": "^2.8.12",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.11"
}
