{
  "name": "church",
  "private": true,
  "version": "0.1.0-rc.3",
  "workspaces": {
    "packages": [
      "apps/server",
      "apps/web",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "better-auth": "1.7.7",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0",
      "vitest": "^5.0.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "dev:web": "turbo -F @church/web dev",
    "dev:desktop": "turbo -F @church/desktop dev:hmr",
    "build:desktop": "turbo -F @church/desktop build:stable",
    "build:desktop:canary": "turbo -F @church/desktop build:canary",
    "dev:server": "turbo -F @church/server dev",
    "db:push": "turbo -F @church/db db:push",
    "db:studio": "turbo -F @church/db db:studio",
    "db:sql": "bun tooling/worktree/db-sql.ts",
    "db:generate": "turbo -F @church/db db:generate",
    "db:migrate": "turbo -F @church/db db:migrate",
    "db:reset:dev": "turbo -F @church/db db:reset:dev",
    "db:start": "turbo -F @church/db db:start",
    "db:watch": "turbo -F @church/db db:watch",
    "db:stop": "turbo -F @church/db db:stop",
    "db:down": "turbo -F @church/db db:down",
    "db:init": "bun run --cwd apps/server db:init-system",
    "db:clean": "turbo -F @church/db db:clean",
    "db:reseed:dev": "bun run --cwd apps/server db:reseed:dev",
    "lint": "bun run lint:files -- . && bun run validate:workspace-scope && bun run validate:test-placement && bun run validate:i18n-parity && bun run validate:named-parameters && bun run validate:server-types && bun run validate:journey-map && bun run validate:e2e-lanes && bun run validate:presentation-text && bun run validate:date-time-seam && bun run validate:bun-version && bun run validate:constitution-version",
    "validate:i18n-parity": "bun tooling/validation/i18n-parity.ts",
    "validate:workspace-scope": "bun tooling/validation/workspace-scope-guard.ts",
    "lint:files": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "lint:fix": "bun run lint:fix:files -- .",
    "lint:fix:files": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "orval": "orval",
    "api:generate": "bun run --cwd apps/server export:openapi && orval",
    "test:unit": "TZ=Asia/Kolkata turbo test:unit --concurrency=2 && bun run test:validation",
    "test:integration": "bun tooling/env/check.ts integration --services=db,auth,server && CHURCH_EXEC_PURPOSE=integration TZ=Asia/Kolkata turbo test:integration --concurrency=3",
    "test:e2e": "turbo test:e2e --filter=@church/web --",
    "test:e2e:ui": "turbo test:e2e:ui --filter=@church/web --",
    "test:seeds": "bun tooling/validation/seed-contracts.ts",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:validation": "bun tooling/ci/bun-test.ts tooling",
    "env:check": "bun tooling/env/check.ts",
    "env:local": "bun tooling/diagnostics/run-managed.ts env:local -- bun tooling/worktree/local-env.ts",
    "db:bootstrap": "bun tooling/diagnostics/run-managed.ts db:bootstrap -- bun tooling/worktree/bootstrap-databases.ts",
    "worktree:bootstrap": "bun tooling/worktree/bootstrap-worktree.ts",
    "db:prune": "bun tooling/diagnostics/run-managed.ts db:prune -- bun tooling/worktree/prune-databases.ts",
    "dns:start": "bun tooling/worktree/dev-dns.ts start",
    "dns:stop": "bun tooling/worktree/dev-dns.ts stop",
    "validate:date-time-seam": "bun tooling/validation/date-time-seam-guards.ts",
    "validate:bun-version": "bun tooling/validation/bun-version-guard.ts",
    "validate:test-placement": "bun tooling/validation/test-placement-guard.ts",
    "validate:named-parameters": "bun tooling/validation/named-parameters-guard.ts",
    "validate:presentation-text": "bun tooling/validation/presentation-text-guard.ts",
    "validate:server-types": "bun tooling/validation/server-types-guard.ts --fail",
    "validate:api-generated": "bun tooling/validation/api-generated-guard.ts",
    "validate:journey-map": "bun tooling/validation/journey-map-guard.ts",
    "validate:e2e-lanes": "bun tooling/validation/e2e-lanes-guard.ts",
    "validate:constitution-version": "bun tooling/validation/constitution-version-guard.ts",
    "perf:sign-in": "bun tooling/perf/sign-in.ts",
    "validate:bundle-budget": "bun tooling/validation/bundle-budget.ts",
    "validate:dev-module-cap": "bun tooling/validation/dev-module-cap.ts",
    "validate:affected": "bun tooling/validation/affected.ts",
    "validate:no-docker": "bun tooling/validation/affected.ts --no-docker",
    "validate": "bun tooling/validation/validate.ts",
    "backup:create": "varlock run --path tooling/deployment -- bun tooling/deployment/backup.ts create",
    "backup:check": "varlock run --path tooling/deployment -- bun tooling/deployment/backup.ts check",
    "deploy:checks": "bun tooling/deployment/deploy.ts checks",
    "deploy:rollout": "varlock run --path tooling/deployment -- bun tooling/deployment/deploy.ts rollout",
    "deploy:release": "bun tooling/deployment/deploy.ts release",
    "deploy:promote": "varlock run --path tooling/deployment -- bun tooling/deployment/deploy.ts promote",
    "release:source-maps": "bun tooling/deployment/source-maps.ts",
    "deploy:rollback": "varlock run --path tooling/deployment -- bun tooling/deployment/deploy.ts rollback",
    "version:rc": "bun tooling/deployment/version.ts rc",
    "version:stable": "bun tooling/deployment/version.ts stable",
    "push:safe": "bash tooling/git-safe-push.sh",
    "commit": "cz"
  },
  "dependencies": {
    "@church/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@biomejs/biome": "^2.2.0",
    "@church/config": "workspace:*",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.61.1",
    "@sentry/cli": "^3.8.2",
    "@types/bun": "catalog:",
    "@types/three": "^0.187.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "fflate": "^0.8.2",
    "lefthook": "^2.1.4",
    "orval": "~8.49.0",
    "turbo": "^2.11.13",
    "typescript": "^5",
    "varlock": "^1.21.0"
  },
  "packageManager": "bun@1.4.5",
  "overrides": {
    "sharp": "^0.35.5"
  }
}
