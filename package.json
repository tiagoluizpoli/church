{
  "name": "base-fullstack-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "@trpc/server": "^11.13.4",
      "better-auth": "1.5.5",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@trpc/client": "^11.13.4",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:desktop": "turbo -F desktop dev:hmr",
    "build:desktop": "turbo -F desktop build:stable",
    "build:desktop:canary": "turbo -F desktop build:canary",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @base-fullstack-template/db db:push",
    "db:studio": "turbo -F @base-fullstack-template/db db:studio",
    "db:generate": "turbo -F @base-fullstack-template/db db:generate",
    "db:migrate": "turbo -F @base-fullstack-template/db db:migrate",
    "db:start": "turbo -F @base-fullstack-template/db db:start",
    "db:watch": "turbo -F @base-fullstack-template/db db:watch",
    "db:stop": "turbo -F @base-fullstack-template/db db:stop",
    "db:down": "turbo -F @base-fullstack-template/db db:down",
    "check": "biome check --write .",
    "commit": "cz"
  },
  "dependencies": {
    "@base-fullstack-template/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@base-fullstack-template/config": "workspace:*",
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "catalog:",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.4",
    "turbo": "^2.8.12",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.11"
}
