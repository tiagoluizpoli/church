# Database-owned Varlock schema (ADR-0005). packages/db consumes only the
# explicit target its caller resolves; this schema declares that contract,
# it does not select development/integration/e2e itself (see
# resolveDatabaseTarget in src/database-target-resolver.ts).
# @defaultSensitive=false @defaultRequired=infer
# @import(../../)
# ---

# @required @sensitive @type=string
DATABASE_URL=

# The current worktree's development database, required only for the e2e
# purpose: getE2eDatabaseUrl (src/e2e-database-url.ts) compares it against
# DATABASE_URL to refuse an e2e target that resolves to development.
# @sensitive @type=string
DEVELOPMENT_DATABASE_URL=
