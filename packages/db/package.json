{
  "name": "@base-fullstack-template/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down",
    "db:seed": "bun --env-file=../../.env scripts/seed.ts",
    "db:init-system": "bun --env-file=../../.env src/scripts/init-system.ts",
    "db:clean": "bun --env-file=../../.env src/scripts/clean-db.ts",
    "seed": "bun run src/seed/index.ts",
    "seed:reset": "bun run src/seed/index.ts --reset",
    "check-types": "tsc --noEmit",
    "test": "bun --env-file=../../.env vitest run"
  },
  "dependencies": {
    "@base-fullstack-template/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@base-fullstack-template/config": "workspace:*",
    "@faker-js/faker": "^10.4.0",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5",
    "vitest": "catalog:"
  }
}
