{
  "name": "@church/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "CHURCH_EXEC_PURPOSE=development varlock run --path . -- drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "CHURCH_EXEC_PURPOSE=development varlock run --path . -- drizzle-kit studio",
    "db:migrate": "CHURCH_EXEC_PURPOSE=development varlock run --path . -- drizzle-kit migrate",
    "db:reset:dev": "CHURCH_EXEC_PURPOSE=development varlock run --path . -- bun src/scripts/reset-db.ts",
    "db:start": "sh ../../tooling/worktree/shared-compose.sh up --detach --wait",
    "db:watch": "sh ../../tooling/worktree/shared-compose.sh up",
    "db:stop": "sh ../../tooling/worktree/shared-compose.sh stop",
    "db:down": "sh ../../tooling/worktree/shared-compose.sh down",
    "db:setup-test": "CHURCH_EXEC_PURPOSE=integration varlock run --path . -- bun src/setup-test-db.ts",
    "db:clean": "CHURCH_EXEC_PURPOSE=development varlock run --path . -- bun src/scripts/clean-db.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "CHURCH_EXEC_PURPOSE=integration bun ../../tooling/diagnostics/run-managed.ts test:integration --step @church/db -- varlock run --path . -- bun vitest run",
    "test": "bun run test:integration"
  },
  "dependencies": {
    "@church/env": "workspace:*",
    "@church/time": "workspace:*",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "catalog:",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@church/config": "workspace:*",
    "@types/pg": "catalog:",
    "better-auth": "1.5.5",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5",
    "vitest": "catalog:"
  }
}
