{
  "name": "@church/i18n",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./messages": {
      "types": "./src/paraglide/messages.d.ts",
      "default": "./src/paraglide/messages.js"
    },
    "./runtime": {
      "types": "./src/paraglide/runtime.d.ts",
      "default": "./src/paraglide/runtime.js"
    }
  },
  "scripts": {
    "postinstall": "bun run compile",
    "paraglide": "paraglide-js compile --project ./project.inlang --strategy cookie custom-app-default-locale baseLocale --silent",
    "compile:locale-modules": "bun run paraglide --outdir ./src/paraglide --output-structure locale-modules --emit-ts-declarations",
    "compile:message-modules": "bun run paraglide --outdir ./src/paraglide-message-modules --output-structure message-modules",
    "compile": "bun ../../tooling/i18n/compile.ts",
    "dev": "bun run compile:locale-modules --watch",
    "typecheck": "bun run compile",
    "test:unit": "bun run compile",
    "build": "bun run compile"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "~2.29.0",
    "@inlang/plugin-message-format": "^4.4.5"
  }
}
