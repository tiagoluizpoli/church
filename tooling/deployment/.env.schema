# Operator backup command schema (tooling/deployment/backup.ts, #880).
# Values come from the caller's environment: the target GitHub Environment's
# secrets/variables in workflows, or the operator's shell. Never commit values.
# Each environment has its own Dokploy backups; see docs/operations/backups.md.
# @defaultSensitive=false @defaultRequired=infer
# ---

# Dokploy panel base URL (the API is under /api).
# @required @type=url
DOKPLOY_URL=

# Dokploy API key (Settings → Profile → API/CLI).
# @required @sensitive @type=string
DOKPLOY_API_KEY=

# Dokploy backup id of the target environment's pre-deployment/reset pool
# (prefix `<environment>/pre-deployment`, schedule disabled, keep 5).
# @required @type=string
CHURCH_BACKUP_ID=

# Production only: Dokploy backup id of the daily scheduled pool
# (prefix `production/scheduled`, daily schedule enabled, keep 5).
# @type=string
CHURCH_SCHEDULED_BACKUP_ID=
