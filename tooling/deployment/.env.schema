# Operator backup and deployment command schema (tooling/deployment/backup.ts #880, deploy.ts #881).
# Values come from the caller's environment: the target GitHub Environment's
# secrets/variables in workflows, or the operator's shell. Never commit values.
# Each environment has its own Dokploy backups; see docs/operations/backups.md.
# @defaultSensitive=false @defaultRequired=infer
# ---

# Dokploy panel base URL (the API is under /api).
# @required @type=url
DOKPLOY_URL=

# Dokploy API key (Settings → Profile → API/CLI).
# @required @sensitive @type=string
DOKPLOY_API_KEY=

# Dokploy backup id of the target environment's pre-deployment/reset pool
# (prefix `<environment>/pre-deployment`, schedule disabled, keep 5).
# @required @type=string
CHURCH_BACKUP_ID=

# Production only: Dokploy backup id of the daily scheduled pool
# (prefix `production/scheduled`, daily schedule enabled, keep 5).
# @type=string
CHURCH_SCHEDULED_BACKUP_ID=

# Deployment command (tooling/deployment/deploy.ts rollout, #881). Required by
# rollout and promote; they name any missing one before touching Dokploy.

# Dokploy Compose id of the target environment (source type Raw).
# @type=string
DOKPLOY_COMPOSE_ID=

# The environment's public origin, checked after rollout, e.g. https://dev.example.org.
# @type=url
PUBLIC_ORIGIN=

# rollout, promote and rollback (#887) also read GITHUB_TOKEN and
# GITHUB_REPOSITORY from the workflow: every verified rollout records its
# image set as a GitHub deployment rollback reads back. Staging rollouts
# (--candidate) publish candidate evidence on the GitHub release; promote
# (#883) resolves that evidence.

# Poll interval for checks, Dokploy and health (default 10000).
# @type=number
CHURCH_DEPLOY_POLL_INTERVAL_MS=
